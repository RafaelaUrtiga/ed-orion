# Copie para agno-rag/.env e preencha. Não vai para o Git.

# Chave da API do Gemini (gerada no Google AI Studio)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Modelos do Gemini (conversa e embeddings)
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=

# Bancos (nomes dos serviços do docker-compose)
QDRANT_URL=http://qdrant:6333
COLLECTION_OR_TABLE_NAME=
POSTGRES_DB_URL=postgresql+psycopg://USUARIO:SENHA@postgres-rag:5432/orion

# Instruções do agente
SYSTEM_PROMPT=
