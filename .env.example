# Copie este arquivo para .env e troque os valores. O .env não vai para o Git.

# MinIO (armazenamento de objetos, padrão S3)
MINIO_HOST=localhost:9000
MINIO_KEY=troque_este_usuario
MINIO_SECRET=troque_esta_senha
MINIO_BUCKET=dados-brutos

# PostgreSQL (textos dos chunks)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=troque_este_usuario
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=orion

# Qdrant (banco de vetores)
QDRANT_HOST=localhost
QDRANT_PORT=6333
